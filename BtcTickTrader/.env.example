# Copy this file to .env (same folder) and fill it in.
# .env is in .gitignore, so nothing here is ever committed.

# IQ Option ssid cookie (BitcoinTickBot logs in with it)
IQ_SSID=

# MT5 account for PriceFeeder (same keys as the TradoWix price feeder)
MT5Settings__AccountNumber=
MT5Settings__Password=
MT5Settings__Server=YourBroker-Server
